# ==========================
# HoneyGuard
# Environment Template
# Copy this file to .env
# ==========================

# Environment
ENV=development

# Backend
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173

# PostgreSQL
POSTGRES_DB=honeyguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Docker
COMPOSE_PROJECT_NAME=honeyguard

# Logging
LOG_LEVEL=INFO
